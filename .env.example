# Port the web server listens on
PORT=3000

# Where ledger.json and receipts/ are stored (back this folder up!)
DATA_DIR=./data

# Optional: require this password (HTTP Basic auth, any username) to open the app.
# Set this if the server is reachable from other devices or the internet.
APP_PASSWORD=

# Optional: Splitwise personal API key, only used to import existing history.
SPLITWISE_API_KEY=

# Optional: let an AI model read hard-to-OCR receipts (messy photos, other languages).
# PRIVACY: receipts you attach are sent to Anthropic for reading. Leave empty to use only local OCR.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Cloud sync (optional): use the same ledger from any device. See docs/CLOUD.md ----
# Option 0: Sign in with Dropbox (shows a Connect button in Settings). Create an App-folder app at
# https://www.dropbox.com/developers/apps and paste its App key; add <APP_URL>/api/dropbox/callback as a Redirect URI.
# DROPBOX_APP_KEY=
# APP_URL=http://localhost:3000   # public address of this app (use https://... when hosted)
# Option 1: a folder your cloud drive (Dropbox/Drive/iCloud/OneDrive) syncs
# SYNC_DIR=~/Dropbox/RoommateLedger
# Option 2: S3-compatible bucket (Backblaze B2, Cloudflare R2, AWS S3, MinIO)
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=
# End-to-end encrypt everything before upload (same passphrase on every device; unrecoverable if lost)
# SYNC_PASSPHRASE=
