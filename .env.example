# Port the web server listens on
PORT=3000

# Where ledger.json and receipts/ are stored (back this folder up!)
DATA_DIR=./data

# Optional: require this password (HTTP Basic auth, any username) to open the app.
# Set this if the server is reachable from other devices or the internet.
APP_PASSWORD=

# Optional: Splitwise personal API key, only used to import existing history.
SPLITWISE_API_KEY=

# Optional: let an AI model read hard-to-OCR receipts (messy photos, other languages).
# PRIVACY: receipts you attach are sent to Anthropic for reading. Leave empty to use only local OCR.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
